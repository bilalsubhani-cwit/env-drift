{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    // CommonJS emit requires a classic resolution; the modern options
    // (node16/nodenext/bundler) all force a non-CommonJS `module`. node10 is
    // deprecated-named but still valid through TS 6.x and is correct here.
    "moduleResolution": "node10",
    "outDir": "dist/cjs",
    "declaration": false,
    "declarationDir": null
  }
}
